#!/usr/bin/env python3
"""
Study Assistant (CLI Entrypoint)
Usage:
  ./learn                      # Interactive menu
  ./learn check [subject]      # Run adaptive placement check
  ./learn chat [subject]       # Start terminal study session
  ./learn roadmap [subject]    # View/update study roadmap
  ./learn notes                # View student notes from Obsidian
  ./learn materials            # Refresh and index course materials
"""

import os
import sys
from typing import Optional

BASE_DIR = os.path.dirname(os.path.abspath(__file__))

# Auto-re-exec into local virtualenv if present
venv_py = os.path.join(BASE_DIR, ".venv", "bin", "python3")
if os.path.exists(venv_py) and sys.executable != os.path.abspath(venv_py):
    os.execv(venv_py, [venv_py] + sys.argv)

ASSISTANT_DIR = os.path.join(BASE_DIR, "assistant")
if BASE_DIR not in sys.path:
    sys.path.insert(0, BASE_DIR)
if ASSISTANT_DIR not in sys.path:
    sys.path.insert(0, ASSISTANT_DIR)

from assistant.boundary_search import KnowledgeBoundarySearch
from assistant.curriculum_planner import CurriculumPlanner
from assistant.obsidian_sync import ObsidianNoteSync
from assistant.rag_manager import MaterialRAGManager
from assistant.terminal_chat import TerminalChatRunner
from assistant.ai_tutor import get_ai_status, call_real_ai

def print_header():
    ai_ok, ai_desc = get_ai_status()
    if ai_ok:
        engine_line = f"  ⚡ AI Engine: Active ({ai_desc})"
    else:
        engine_line = f"  ⚠️  AI Engine: {ai_desc}\n  👉 Set GEMINI_API_KEY in .env for dynamic AI generation"
    
    print(f"""
======================================================================
  Personalized Study Assistant
{engine_line}
======================================================================
    """.strip("\n"))

def resolve_subject(explicit_subject: Optional[str] = None) -> str:
    """
    Resolves target subject by checking command args, scanning material/,
    and prompting the student with clear choices.
    """
    rag = MaterialRAGManager()
    materials = rag.scan_materials()
    subjects = list(materials.keys())

    # 1. If explicitly passed via command line (e.g. ./learn check biology)
    if explicit_subject:
        subj_clean = explicit_subject.strip().lower()
        subj_dir = os.path.join(rag.material_dir, subj_clean)
        os.makedirs(subj_dir, exist_ok=True)
        return subj_clean

    # 2. Interactive selection prompt
    print("\n📚 Choose a subject to study:")
    if subjects:
        for idx, s in enumerate(subjects, 1):
            count = len(materials[s])
            print(f"  {idx}. {s.capitalize()} ({count} material file{'s' if count != 1 else ''})")
        print(f"  {len(subjects) + 1}. Add or type a new subject / topic...")
    else:
        print("  1. Add or type a new subject / topic...")

    prompt_text = f"\nSelect [1-{len(subjects) + 1}] or type a topic name (default 1): " if subjects else "\nEnter subject name: "
    try:
        choice = input(prompt_text).strip()
    except (EOFError, KeyboardInterrupt):
        choice = ""

    if not choice:
        return subjects[0] if subjects else "general"

    # If the user typed a number matching an existing subject
    if choice.isdigit():
        num = int(choice)
        if 1 <= num <= len(subjects):
            return subjects[num - 1]
        elif num == len(subjects) + 1:
            try:
                new_subj = input("\nEnter the subject name (e.g. biology, linear_algebra, history): ").strip()
                if new_subj:
                    new_clean = new_subj.lower().replace(" ", "_")
                    os.makedirs(os.path.join(rag.material_dir, new_clean), exist_ok=True)
                    print(f"✓ Configured subject '{new_subj.capitalize()}' in material/{new_clean}/")
                    return new_clean
            except (EOFError, KeyboardInterrupt):
                pass
            return subjects[0] if subjects else "general"

    # If the user directly typed the name of a topic (e.g. 'biology' or 'french')
    clean_choice = choice.lower().replace(" ", "_")
    os.makedirs(os.path.join(rag.material_dir, clean_choice), exist_ok=True)
    if clean_choice not in subjects:
        print(f"✓ Configured subject '{choice.capitalize()}' in material/{clean_choice}/")
    return clean_choice

def cmd_status(subject: Optional[str] = None):
    print_header()
    subj = resolve_subject(subject)
    planner = CurriculumPlanner(subject=subj)
    planner.print_terminal_roadmap()

    rag = MaterialRAGManager()
    materials = rag.scan_materials()
    print("Course Materials:")
    for s, files in materials.items():
        print(f"  • {s.capitalize()}:")
        for f in files:
            print(f"    - {os.path.basename(f)}")

    sync = ObsidianNoteSync()
    notes = sync.read_scratchpad_notes()
    if notes:
        print(f"\nNotes from Obsidian ({len(notes)}):")
        for n in notes:
            print(f"  • {n}")
    print("\nOpen 'md/' in Obsidian or your markdown editor to view interactive diagrams & flashcards.")

def cmd_probe(subject: Optional[str] = None):
    subj = resolve_subject(subject)
    search = KnowledgeBoundarySearch(subject=subj)
    boundary = search.run_interactive_assessment()
    planner = CurriculumPlanner(subject=subj, boundary_level=boundary)
    planner.update_dashboard()
    planner.print_terminal_roadmap()

def cmd_roadmap(subject: Optional[str] = None):
    subj = resolve_subject(subject)
    planner = CurriculumPlanner(subject=subj)
    planner.update_dashboard()
    planner.print_terminal_roadmap()

def cmd_sync():
    sync = ObsidianNoteSync()
    notes = sync.read_scratchpad_notes()
    module_notes = sync.scan_all_module_notes()
    print("\nYour Obsidian Notes:")
    if notes:
        for n in notes:
            print(f"  • {n}")
    if module_notes:
        for mod, n_list in module_notes.items():
            for n in n_list:
                print(f"  • [{mod}] {n}")
    if not notes and not module_notes:
        print("  (No notes found. You can add notes anytime in md/03_STUDENT_OBSIDIAN_SCRATCHPAD.md)")

def cmd_ingest():
    rag = MaterialRAGManager()
    chunks = rag.build_index()
    print(f"\nCourse materials refreshed successfully ({chunks} sections indexed).")

def cmd_chat(subject: Optional[str] = None):
    subj = resolve_subject(subject)
    runner = TerminalChatRunner(subject=subj)
    runner.start_session(interactive_repl=True)

def cmd_doctor():
    print_header()
    print("\n🔍 System Health & Diagnostic Check:")
    print("-" * 65)

    # 1. AI Connection Test
    ai_ok, ai_desc = get_ai_status()
    if ai_ok:
        print(f"  [✓] AI Engine: Connected via {ai_desc}")
        print("      Testing live model ping... ", end="", flush=True)
        try:
            res = call_real_ai("Respond with the exact word 'PONG'")
            if "pong" in res.lower():
                print("OK! (Dynamic AI intelligence active)")
            else:
                print(f"Response received ({res[:40]}...)")
        except Exception as e:
            print(f"Warning ({e})")
    else:
        print("  [!] AI Engine: Offline Mode")
        print("      No API key was detected in your environment or .env file.")
        print("      Without an API key, the system uses static offline fallback questions.")
        print("      To activate live dynamic generation and adaptive tutoring:")
        print("        1. Copy .env.example to .env:  cp .env.example .env")
        print("        2. Add a Gemini key:          GEMINI_API_KEY=AIzaSy...")
        print("           (or OPENAI_API_KEY / ANTHROPIC_API_KEY / GROQ_API_KEY)")

    # 2. Materials
    rag = MaterialRAGManager()
    mats = rag.scan_materials()
    print(f"\n  [✓] Course Materials: {len(mats)} subject folder(s) found in material/")
    for s, files in mats.items():
        print(f"      • {s}: {len(files)} document(s)")
    if not mats:
        print("      (Tip: Drop PDFs or notes into material/<subject>/ to ground the tutor)")

    # 3. Obsidian Vault
    md_dir = os.path.abspath(os.path.join(BASE_DIR, "md"))
    dash = os.path.join(md_dir, "00_INDEX_DASHBOARD.md")
    if os.path.exists(dash):
        print(f"\n  [✓] Obsidian Vault: Active at {md_dir}")
    else:
        print(f"\n  [!] Obsidian Vault: Not yet initialized (run ./learn check to create it)")

    # 4. CLI Tools
    import shutil
    aichat_installed = shutil.which("aichat") is not None
    print(f"\n  [{'✓' if aichat_installed else '·'}] AIChat CLI: {'Installed' if aichat_installed else 'Optional (Direct Python REPL active)'}")
    print("-" * 65 + "\n")

def interactive_menu():
    while True:
        print_header()
        print("\nChoose an option:")
        print("  1. Placement Check (Find where to start)")
        print("  2. Start Study Session (Terminal chat)")
        print("  3. View Study Progress & Topics")
        print("  4. View My Notes & Questions")
        print("  5. Refresh Course Materials")
        print("  6. System Health & AI Diagnostic Check")
        print("  7. Exit")

        try:
            choice = input("\nSelect [1-7]: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nGoodbye!")
            break

        if choice == "1":
            cmd_probe()
            input("\nPress Enter to return to menu...")
        elif choice == "2":
            cmd_chat()
            input("\nPress Enter to return to menu...")
        elif choice == "3":
            cmd_status()
            input("\nPress Enter to return to menu...")
        elif choice == "4":
            cmd_sync()
            input("\nPress Enter to return to menu...")
        elif choice == "5":
            cmd_ingest()
            input("\nPress Enter to return to menu...")
        elif choice == "6":
            cmd_doctor()
            input("\nPress Enter to return to menu...")
        elif choice in ["7", "q", "exit"]:
            print("\nGoodbye!")
            break
        else:
            print("Please select 1-7.")

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        sub_arg = sys.argv[2] if len(sys.argv) > 2 else None

        if arg in ["probe", "check", "diagnostic"]:
            cmd_probe(subject=sub_arg)
        elif arg in ["chat", "start", "session"]:
            cmd_chat(subject=sub_arg)
        elif arg in ["roadmap"]:
            cmd_roadmap(subject=sub_arg)
        elif arg in ["progress", "status"]:
            cmd_status(subject=sub_arg)
        elif arg in ["sync", "notes"]:
            cmd_sync()
        elif arg in ["ingest", "materials"]:
            cmd_ingest()
        elif arg in ["doctor", "health", "checkup"]:
            cmd_doctor()
        elif arg in ["help", "-h", "--help"]:
            print(__doc__)
        else:
            print(f"Unknown command: '{arg}'\n{__doc__}")
    else:
        interactive_menu()

if __name__ == "__main__":
    main()
